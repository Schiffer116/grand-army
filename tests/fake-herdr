#!/usr/bin/env bash
# A Herdr with an empty Grand Army: it answers `api snapshot` and nothing else.
# It stands in for Herdr in TestSystemdUnitsStart only (every unit's ExecStart
# starts against it); everything else is tested on the Host fakes (hosttest).
[[ $1 == --session ]] && shift 2
[[ "$1 $2" == "api snapshot" ]] && echo '{"result":{"snapshot":{"workspaces":[],"agents":[],"panes":[]}}}'
exit 0
